# ---------------------------------------------------------------
# STM32CubeIDE build output (regenerated on every build)
# ---------------------------------------------------------------
/Debug/
/Release/

# Compiler / linker artifacts (in case they appear outside the build folders)
*.o
*.d
*.su
*.cyclo
*.elf
*.map
*.list
*.bin
*.hex
*.srec

# ---------------------------------------------------------------
# STM32CubeIDE / Eclipse machine-specific or per-user files
# ---------------------------------------------------------------
# Indexer discovery cache (contains a toolchain env-hash; regenerated by the IDE)
/.settings/language.settings.xml
# SFR viewer UI state
/.settings/com.st.stm32cube.ide.mcu.sfrview.prefs
# Debug launch configurations and generated OpenOCD/ST-LINK scripts
# (may contain absolute local paths; the IDE recreates them on first debug)
*.launch
/*.cfg
# Eclipse workspace metadata (only present if the workspace is the repo itself)
.metadata/
RemoteSystemsTempFiles/

# ---------------------------------------------------------------
# OS / editor files
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
